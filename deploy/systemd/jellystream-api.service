[Unit]
Description=JellyStream API backend (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oarko
Group=oarko
WorkingDirectory=/home/oarko/jellystream
ExecStart=/home/oarko/jellystream/venv/bin/python3 /home/oarko/jellystream/run.py
Restart=on-failure
RestartSec=5

# JellyStream manages its own size/backup-count rotating file log under
# ./logs (see LOG_FILE_MAX_BYTES / LOG_FILE_BACKUP_COUNT / LOG_RETENTION_DAYS
# in .env) — that stays the durable record. Also send stdout/stderr to the
# journal so `journalctl -u jellystream-api -f` works for live tailing.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jellystream-api

# Deliberately minimal sandboxing: this service needs to open GPU device
# nodes (/dev/dri/renderD1xx) for hwaccel transcoding and may read media over
# network mounts (see MEDIA_PATH_MAP), so directives like PrivateDevices=,
# ProtectSystem=strict, or ProtectHome= are intentionally left off — they can
# silently break either of those. NoNewPrivileges is safe and doesn't affect
# either.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
