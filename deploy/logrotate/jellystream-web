# logrotate rule for JellyStream's lighttpd frontend logs.
#
# Lighttpd itself has no built-in size-based log rotation — this is the
# standard Debian/Ubuntu way to bound plain log files by size. The Python
# API backend does NOT need this: it already rotates its own logs by size
# (LOG_FILE_MAX_BYTES/LOG_FILE_BACKUP_COUNT in .env) via Python's
# RotatingFileHandler, so don't add a second rule for ./logs/jellystream_*.log
# here — two rotators fighting over the same file will corrupt rotation.
#
# copytruncate is used (rather than the usual rotate+signal-reopen dance)
# because our custom lighttpd.conf (generated by start-lighttpd.sh) doesn't
# wire up a reload hook — copytruncate needs no cooperation from lighttpd at
# all, at the cost of possibly losing the handful of log lines written in
# the instant between the copy and the truncate. Fine for access/error logs.
#
# Install:
#   sudo cp deploy/logrotate/jellystream-web /etc/logrotate.d/jellystream-web
#   sudo logrotate -d /etc/logrotate.d/jellystream-web   # dry run
#
# Adjust the path below if JellyStream isn't installed at
# /home/oarko/jellystream on this machine.

/home/oarko/jellystream/logs/lighttpd-access.log
/home/oarko/jellystream/logs/lighttpd-error.log
{
    weekly
    size 10M
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
